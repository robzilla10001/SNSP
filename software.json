{
  "_comment": "Each entry = one piece of software. 'repo' is owner/name on GitHub. Each download has a 'match' rule that picks an asset from the LATEST release, plus optional 'dest_subdir' (where a loose, non-archive file is placed),'rename-extracted' ([ ['blob', 'new_name'] ]) 'rename' and 'strip_prefix' (if the zip extracts to something other than absolute paths). Match types: {\"first\": true} = top asset; {\"index\": N} = Nth asset (0-based); {\"name\": \"x.zip\", \"ext_fallback\": true} = exact filename (case-insensitive), falling back to the only/first asset with that extension if the exact name is gone; {\"regex\": \"...\"} = regex on asset name. Archive assets (.zip/.7z/.rar/.tar*) are always extracted+merged into the root; non-archive assets are copied into dest_subdir (default root). Edit freely.",
  "software": [
    { "name": "Atmosphere",            "repo": "borntohonk/Atmosphere",            "downloads": [ { "match": { "first": true } } ] },
	{ "name": "Hekate+Nyx",            "repo": "CTCaer/hekate",                    "downloads": [ { "match": { "regex": "(?i)hekate_ctcaer_.*_Nyx_.*\\.zip" }, "rename_extracted": [ ["hekate_ctcaer_*.bin", "payload.bin"] ] } ] },
    { "name": "Cyberfoil",             "repo": "luketanti/CyberFoil",              "downloads": [ { "match": { "first": true } } ] },
    { "name": "DBI RU",                "repo": "rashevskyv/dbi",                   "downloads": [ 
        { "match": { "name": "DBI.nro", "ext_fallback": true }, "dest_subdir": "switch/DBI-RU" },
		{ "match": { "name": "dbi.config", "ext_fallback": true }, "dest_subdir": "switch/DBI-RU" } ] },
    { "name": "DBI English",           "repo": "rashevskyv/DBIPatcher",            "downloads": [
        { "match": { "name": "DBI.nro", "ext_fallback": true }, "dest_subdir": "switch/DBI" },
        { "match": { "name": "translation_en.bin" }, "rename": "translation.bin", "dest_subdir": "switch/DBI" }
    ] },
    { "name": "JKSV",                  "repo": "J-D-K/JKSV",                       "downloads": [ { "match": { "name": "JKSV.nro", "ext_fallback": true }, "dest_subdir": "switch" } ] },
    { "name": "Linkalho",              "repo": "impeeza/linkalho",                 "downloads": [ { "match": { "first": true }, "dest_subdir": "switch" } ] },
    { "name": "NXThemeInstaller",      "repo": "exelix11/SwitchThemeInjector",     "downloads": [ { "match": { "name": "NXThemesInstaller.nro", "ext_fallback": true }, "dest_subdir": "switch" } ] },
    { "name": "Sphaira",               "repo": "NaGaa95/sphaira",                  "downloads": [ { "match": { "name": "sphaira.zip", "ext_fallback": true } } ] },
    { "name": "Switch90DNSTester",     "repo": "meganukebmp/Switch_90DNS_tester",  "downloads": [ { "match": { "regex": "(?i)9.?0.?dns.*\\.nro" }, "dest_subdir": "switch" } ] },
    { "name": "Disable Remap dialog",  "repo": "ndeadly/disable_remap_dialog",     "downloads": [ { "match": { "regex": "(?i)disable_remap_dialog.*\\.zip" } } ] },
    { "name": "Mission Control",       "repo": "ndeadly/MissionControl",           "downloads": [ { "match": { "first": true } } ] },
    { "name": "SaltyNX",               "repo": "masagrator/SaltyNX",               "downloads": [ { "match": { "name": "SaltyNX.zip", "ext_fallback": true } } ] },
    { "name": "Nx-ovlloader",          "repo": "ppkantorski/nx-ovlloader",         "downloads": [ { "match": { "name": "nx-ovlloader.zip", "ext_fallback": true } } ] },
    { "name": "FuseCheck",             "repo": "sthetix/FuseCheck",                "downloads": [ { "match": { "first": true } } ] },
    { "name": "Lockpick RCM Pro",      "repo": "sthetix/Lockpick_RCM_Pro",         "downloads": [ { "match": { "first": true } } ] },
    { "name": "Netman",                "repo": "sthetix/NetMan",                   "downloads": [ { "match": { "first": true } } ] },
    { "name": "TegraExplorer Ext",     "repo": "sthetix/TegraExplorer-Ext",        "downloads": [ { "match": { "first": true } } ] },
    { "name": "Modchip Toolbox",       "repo": "DefenderOfHyrule/modchip-toolbox",  "downloads": [ { "match": { "name": "modchip_toolbox.bin", "ext_fallback": true }, "dest_subdir": "bootloader/payloads" } ] },
    { "name": "Edizon",                "repo": "proferabg/EdiZon-Overlay",         "downloads": [ { "match": { "name": "EdiZon-Overlay.zip", "ext_fallback": true } } ] },
    { "name": "FPSLocker",             "repo": "ppkantorski/FPSLocker",            "downloads": [ { "match": { "name": "FPSLocker.ovl", "ext_fallback": true }, "dest_subdir": "switch/.overlays" } ] },
    { "name": "QuickNTP",              "repo": "ppkantorski/QuickNTP",             "downloads": [ { "match": { "name": "QuickNTP.ovl" }, "dest_subdir": "switch/.overlays" } ] },
    { "name": "Ultrahand",             "repo": "ppkantorski/Ultrahand-Overlay",    "downloads": [ { "match": { "name": "ovlmenu.ovl", "ext_fallback": true }, "dest_subdir": "switch/.overlays" } ] },
	{ "name": "Horizon-OC",            "repo": "Horizon-OC/Horizon-OC",            "downloads": [ { "match": { "name": "dist.zip", "ext_fallback": false } } ] },
    { "name": "Emuiibo",               "repo": "XorTroll/emuiibo",                 "downloads": [ { "match": { "first": true }, "strip_prefix": "SdOut" } ] },
    { "name": "sys-tune",              "repo": "ppkantorski/sys-tune",             "downloads": [ { "match": { "first": true } } ] }
  ]
}
